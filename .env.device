# Build Capacitor pour tester sur un VRAI téléphone contre tes serveurs de
# dev locaux (voir run.sh) — le téléphone et ce Mac doivent être sur le même
# Wi-Fi. Contrairement au simulateur, un vrai appareil ne peut pas résoudre
# "localhost" vers ce Mac : il faut son adresse IP locale.
#
# Cette IP change si tu changes de réseau — mets-la à jour au besoin avec :
#   ipconfig getifaddr en0
#
# Chargé via `npm run build:device` (vite --mode device).
VITE_PUZZLE_API_URL=http://192.168.1.75:8787
VITE_REALTIME_URL=ws://192.168.1.75:8080
VITE_PUBLIC_APP_URL=http://192.168.1.75:5173
