{
  "name": "mots-fleches",
  "version": "0.1.0",
  "description": "Jeu de mots fléchés multijoueur en temps réel, pensé mobile-first.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host",
    "generate-clues": "node scripts/generate-clues.mjs",
    "build:mobile": "tsc -b && vite build --mode mobile",
    "cap:sync": "npm run build:mobile && npx cap sync",
    "build:simulator": "tsc -b && vite build --mode simulator",
    "cap:sync:simulator": "npm run build:simulator && npx cap sync ios",
    "build:device": "tsc -b && vite build --mode device",
    "cap:sync:device": "npm run build:device && npx cap sync ios",
    "check:urls": "bash scripts/check-mobile-urls.sh"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.0",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@supabase/supabase-js": "^2.45.4",
    "framer-motion": "^11.11.17",
    "howler": "^2.2.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/ios": "^8.5.0",
    "@types/howler": "^2.2.11",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vite-plugin-pwa": "^0.20.5"
  }
}
