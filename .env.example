# Serveur temps reel des parties (server/index.js).
# Laisse vide pour utiliser la meme origine (proxy /ws en dev).
VITE_REALTIME_URL=

# Domaine public utilise pour le lien d'invitation multijoueur.
# Laisse vide pour utiliser https://teamword-snowy.vercel.app.
# Indispensable si tu changes de domaine : les URLs de PREVIEW Vercel sont
# protegees et obligeraient l'invite a se connecter a Vercel.
VITE_PUBLIC_APP_URL=

# Serveur de remplissage des grilles (scripts/grid_generation/serve_puzzles.py).
# Par defaut http://127.0.0.1:8787 ; sans lui l'app retombe sur la grille de demo.
VITE_PUZZLE_API_URL=

# Liveblocks (realtime multiplayer). Leave blank to run in local single-player mode.
# Get a key at https://liveblocks.io -> your project -> API keys ("public" key, starts with pk_).
VITE_LIVEBLOCKS_PUBLIC_KEY=

# "Se connecter avec Google" (creation de compte sans mot de passe).
# Google Cloud Console -> APIs & Services -> Identifiants -> Creer des
# identifiants -> ID client OAuth -> type "Application Web".
# Origines JavaScript autorisees ET URI de redirection : http://localhost:5173
# en dev, ton domaine Vercel en prod (les deux, un par ligne, dans le meme champ).
# -> tu obtiens un Client ID qui se termine par .apps.googleusercontent.com
# PAS un secret : verifie cote serveur via les cles publiques de Google, sur
# la seule foi du jeton signe (voir server/websocket/oauth.js).
VITE_GOOGLE_CLIENT_ID=

# "Se connecter avec Apple" (creation de compte sans mot de passe — Apple
# l'EXIGE des qu'une autre methode de connexion existe sur iOS, regle 4.8).
# Apple Developer -> Certificates, IDs & Profiles :
#  1. Sur l'App ID existant (com.teamwords.app) -> cocher la capacite
#     "Sign In with Apple".
#  2. Creer un nouveau Services ID (ex. com.teamwords.web) -> activer
#     "Sign In with Apple" -> le configurer avec :
#       Domaine        : ton domaine Vercel (sans https://)
#       Return URL     : la racine de l'app, https://<domaine>/ ET
#                        http://localhost:5173/ pour tester en local
# -> tu obtiens un Services ID (ex. com.teamwords.web), pas un secret non
# plus — meme principe de verification que Google, contre les cles
# publiques d'Apple.
VITE_APPLE_SERVICES_ID=

# Only used by scripts/generate-clues.mjs (never shipped to the browser).
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Serveur temps reel (server/websocket/) UNIQUEMENT — jamais lu par le front.
# Va dans .env.supabase.postgres a la racine (jamais commite), pas ici.
#
# Persistance Postgres (Supabase) : comptes, profils, parties, sessions,
# blocages. Recupere-le sur https://supabase.com -> ton projet -> Connect ->
# ORMs -> "URI" (connexion DIRECTE, port 5432, PAS le pooler PgBouncer sur
# 6543 : ce serveur est un process long-vivant qui garde son propre pool).
#
# POSTGRES_URL_NON_POOLING=postgres://postgres.<ref>:<password>@<host>:5432/postgres?sslmode=require
#
# Verification des connexions Google/Apple cote serveur (aud) — MEMES
# valeurs que VITE_GOOGLE_CLIENT_ID / VITE_APPLE_SERVICES_ID ci-dessus.
#
# GOOGLE_CLIENT_ID=
# APPLE_SERVICES_ID=
