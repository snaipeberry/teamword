# Serveur de remplissage des grilles (scripts/grid_generation/serve_puzzles.py).
# Par defaut http://127.0.0.1:8787 ; sans lui l'app retombe sur la grille de demo.
VITE_PUZZLE_API_URL=

# Liveblocks (realtime multiplayer). Leave blank to run in local single-player mode.
# Get a key at https://liveblocks.io -> your project -> API keys ("public" key, starts with pk_).
VITE_LIVEBLOCKS_PUBLIC_KEY=

# Supabase (puzzle content + accounts). Leave blank to fall back to the bundled demo puzzle.
# Get these at https://supabase.com -> your project -> Project Settings -> API.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Only used by scripts/generate-clues.mjs (never shipped to the browser).
ANTHROPIC_API_KEY=
