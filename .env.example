# Serveur temps reel des parties (server/index.js).
# Laisse vide pour utiliser la meme origine (proxy /ws en dev).
VITE_REALTIME_URL=

# Domaine public utilise pour le lien d'invitation multijoueur.
# Laisse vide pour utiliser https://teamword-snowy.vercel.app.
# Indispensable si tu changes de domaine : les URLs de PREVIEW Vercel sont
# protegees et obligeraient l'invite a se connecter a Vercel.
VITE_PUBLIC_APP_URL=

# Serveur de remplissage des grilles (scripts/grid_generation/serve_puzzles.py).
# Par defaut http://127.0.0.1:8787 ; sans lui l'app retombe sur la grille de demo.
VITE_PUZZLE_API_URL=

# Liveblocks (realtime multiplayer). Leave blank to run in local single-player mode.
# Get a key at https://liveblocks.io -> your project -> API keys ("public" key, starts with pk_).
VITE_LIVEBLOCKS_PUBLIC_KEY=

# Only used by scripts/generate-clues.mjs (never shipped to the browser).
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Serveur temps reel (server/websocket/) UNIQUEMENT — jamais lu par le front.
# Persistance Postgres (Supabase) : comptes, profils, parties, sessions,
# blocages. Va dans .env.supabase.postgres a la racine (jamais commite),
# pas ici. Recupere-le sur https://supabase.com -> ton projet -> Connect ->
# ORMs -> "URI" (connexion DIRECTE, port 5432, PAS le pooler PgBouncer sur
# 6543 : ce serveur est un process long-vivant qui garde son propre pool).
#
# POSTGRES_URL_NON_POOLING=postgres://postgres.<ref>:<password>@<host>:5432/postgres?sslmode=require
